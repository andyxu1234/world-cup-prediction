# ── 数据库 ──
DB_PASSWORD=your_db_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=worldcup_prediction
DB_USER=root

# ── OfoxAI 统一 AI 网关 ──
OFOXAI_API_KEY=your_ofoxai_api_key_here
OFOXAI_BASE_URL=https://api.ofox.ai/v1

# ── Highlightly (比赛数据源) ──
HIGHLIGHTLY_API_KEY=your_highlightly_api_key_here

# ── 微信小程序 ──
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# ── JWT 密钥（生产环境务必更换） ──
SECRET_KEY=change-this-to-a-random-secret-in-production

# ── Telegram Bot 推送 ──
# 从 @BotFather 获取 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 推送目标 Chat ID，多个用逗号分隔（支持个人和群组）
# 获取方式：向 @userinfobot 发送消息获取个人 Chat ID
# 群组 Chat ID 通常为负数，如 -1001234567890
TELEGRAM_CHAT_IDS=your_chat_id_1,your_chat_id_2

# ── Polymarket Standalone 市场 ──
# NO farming 最高入场价格（默认 0.65 = 65¢）
POLYMARKET_MAX_ENTRY_PRICE=0.65
# 只保留未来 N 个月内结束的市场（默认 3）
POLYMARKET_MAX_END_DATE_MONTHS=3
